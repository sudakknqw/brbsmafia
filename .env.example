# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Адрес сайта без слеша в конце (локально http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Discord → настройки канала → Интеграции → Вебхуки → Копировать URL
DISCORD_WEBHOOK_URL=

# Часовой пояс, по которому в Discord начинается новый день
CREW_TIMEZONE=Europe/Moscow

# Любая длинная случайная строка, защищает ежедневную задачу
CRON_SECRET=

# Telegram: токен бота от @BotFather, ID вашей группы (бот должен быть в ней)
# и ссылка на мини-приложение вида https://t.me/имя_бота/app
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
NEXT_PUBLIC_TELEGRAM_APP_URL=

# Steam: сортировка игр по тому, кто во что играет. Ключ — steamcommunity.com/dev/apikey
STEAM_API_KEY=
